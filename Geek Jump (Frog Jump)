import java.util.Arrays;

/**
 * Problem: Geek Jump (Frog Jump)
 * 
 * Description:
 * A frog is at index 0 and wants to reach index (n - 1). 
 * It can jump either 1 step or 2 steps forward at a time. 
 * The cost of a jump from index i to j is |height[i] - height[j]|.
 * Find the minimum total energy spent to reach index (n - 1).
 */
public class GeekJump {

    /**
     * Approach 1: Space Optimized Dynamic Programming
     * Time Complexity:  O(N)
     * Space Complexity: O(1)
     */
    public int minCostSpaceOptimized(int[] height) {
        int n = height.length;
        if (n <= 1) return 0;

        int prev2 = 0;
        int prev = 0;

        for (int i = 1; i < n; i++) {
            int jumpOne = prev + Math.abs(height[i] - height[i - 1]);
            int jumpTwo = Integer.MAX_VALUE;

            if (i > 1) {
                jumpTwo = prev2 + Math.abs(height[i] - height[i - 2]);
            }

            int current = Math.min(jumpOne, jumpTwo);
            prev2 = prev;
            prev = current;
        }

        return prev;
    }

    /**
     * Approach 2: Memoization (Top-Down DP)
     * Time Complexity:  O(N)
     * Space Complexity: O(N) + O(N) auxiliary stack space
     */
    public int minCostMemoization(int[] height) {
        int n = height.length;
        int[] dp = new int[n];
        Arrays.fill(dp, -1);
        return solveMemo(n - 1, height, dp);
    }

    private int solveMemo(int idx, int[] height, int[] dp) {
        if (idx == 0) return 0;
        if (dp[idx] != -1) return dp[idx];

        int jumpOne = solveMemo(idx - 1, height, dp) + Math.abs(height[idx] - height[idx - 1]);
        int jumpTwo = Integer.MAX_VALUE;

        if (idx > 1) {
            jumpTwo = solveMemo(idx - 2, height, dp) + Math.abs(height[idx] - height[idx - 2]);
        }

        return dp[idx] = Math.min(jumpOne, jumpTwo);
    }

    /**
     * Approach 3: Tabulation (Bottom-Up DP)
     * Time Complexity:  O(N)
     * Space Complexity: O(N)
     */
    public int minCostTabulation(int[] height) {
        int n = height.length;
        if (n <= 1) return 0;

        int[] dp = new int[n];
        dp[0] = 0;

        for (int i = 1; i < n; i++) {
            int jumpOne = dp[i - 1] + Math.abs(height[i] - height[i - 1]);
            int jumpTwo = Integer.MAX_VALUE;

            if (i > 1) {
                jumpTwo = dp[i - 2] + Math.abs(height[i] - height[i - 2]);
            }

            dp[i] = Math.min(jumpOne, jumpTwo);
        }

        return dp[n - 1];
    }

    public static void main(String[] args) {
        GeekJump solution = new GeekJump();
        int[] height = {30, 10, 60, 10, 60, 50};

        System.out.println("Space-Optimized: " + solution.minCostSpaceOptimized(height));
        System.out.println("Memoization:     " + solution.minCostMemoization(height));
        System.out.println("Tabulation:      " + solution.minCostTabulation(height));
    }
}
